# Dependencies, installed by npm in the repository root and in tests/.
node_modules/

# The package project's build output and the packed package.
nuget/bin/
nuget/obj/
artifacts/

# What an IDE builds of the package consumer the full gate copies out of the repository.
scripts/packages/*/bin/
scripts/packages/*/obj/

# The bundle that build.ps1 makes from src/.
nuget/wwwroot/

# The browser CI installs for the browser tests.
.playwright/

# Work that stays out of the repository: experiments, spikes, notes, scratch and temporary files, and benchmark baselines.
.sandbox/

# npm's logs.
npm-debug.log*

# Editors and the operating system.
.vs/
.idea/
*.user
.DS_Store
Thumbs.db
