<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <StaticWebAssetBasePath>_content/domql</StaticWebAssetBasePath>
    </PropertyGroup>

    <!-- The package a host references. It ships DOMQL as the one bundled file wwwroot/domql.js, which scripts/bundle.mjs makes from src/. -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>formaui-net.DOMQL</PackageId>
        <Authors>Eyal Alon</Authors>
        <Description>DOMQL is a JavaScript library for querying the DOM, allowing you to read information from a document once or observe it as it changes.</Description>
        <PackageTags>domql;dom;query;language;csharp;javascript;dotnet;browser;forma;formaui</PackageTags>
        <PackageProjectUrl>https://github.com/FormaUI/Forma.DOMQL</PackageProjectUrl>
        <RepositoryUrl>https://github.com/FormaUI/Forma.DOMQL</RepositoryUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- The version: the runtime release version src/Versions.mjs declares, so the package, the bundle and the sources report one version. -->
    <PropertyGroup>
        <VersionsSource>$(MSBuildProjectDirectory)\..\src\Versions.mjs</VersionsSource>
        <Version>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(VersionsSource)')), '(?s)^.*runtime = \x27([^\x27]+)\x27.*$', '$1'))</Version>
        <PackageVersion>$(Version)</PackageVersion>
    </PropertyGroup>

    <!-- A package without the bundle would ship nothing, and one whose bundle answers another version would misreport itself, so packing stops until publish.ps1 has made the bundle of this version. -->
    <Target Name="EnsureBundle" BeforeTargets="Pack">
        <Error Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\domql.js')" Text="wwwroot/domql.js is missing; run ./publish.ps1, which bundles DOMQL and packs it." />
        <Error Condition="!$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\wwwroot\domql.js').Contains('&quot;$(Version)&quot;'))" Text="wwwroot/domql.js answers another version than $(Version); run ./publish.ps1, which bundles DOMQL of this version and packs it." />
    </Target>

</Project>
