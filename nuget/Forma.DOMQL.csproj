<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <StaticWebAssetBasePath>_content/domql</StaticWebAssetBasePath>
    </PropertyGroup>

    <!-- The package a host references. It ships DOMQL as the one bundled file wwwroot/domql.js, which scripts/bundle.mjs makes from src/. -->
    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>formaui-net.DOMQL</PackageId>
        <VersionPrefix>1.0.0</VersionPrefix>
        <Authors>Eyal Alon</Authors>
        <Description>DOMQL is a small, extensible query language for reading DOM state as plain data. Describe what you need, and receive a snapshot shaped by your query.</Description>
        <PackageTags>domql;dom;query;language;csharp;javascript;dotnet;browser;forma;formaui</PackageTags>
        <PackageProjectUrl>https://github.com/FormaUI/Forma.DOMQL</PackageProjectUrl>
        <RepositoryUrl>https://github.com/FormaUI/Forma.DOMQL</RepositoryUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
        <None Include="..\NOTICE" Pack="true" PackagePath="\" Visible="false" />
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <!-- The version: an alpha of 1.0.0 numbered by the commits of the history it is built from, so a clone counts only as much history as it holds. -->
    <Target Name="NumberAlphaByCommits" BeforeTargets="GetAssemblyVersion;GenerateNuspec">
        <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
            <Output TaskParameter="ConsoleOutput" PropertyName="CommitCount" />
        </Exec>
        <PropertyGroup>
            <Version>$(VersionPrefix)-alpha.$(CommitCount)</Version>
            <PackageVersion>$(Version)</PackageVersion>
        </PropertyGroup>
    </Target>

    <!-- A package without the bundle would ship nothing, and one whose bundle answers another version would misreport itself, so packing stops until publish.ps1 has made the bundle of this version. -->
    <Target Name="EnsureBundle" BeforeTargets="Pack" DependsOnTargets="NumberAlphaByCommits">
        <Error Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot\domql.js')" Text="wwwroot/domql.js is missing; run ./publish.ps1, which bundles DOMQL and packs it." />
        <Error Condition="!$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\wwwroot\domql.js').Contains('&quot;$(Version)&quot;'))" Text="wwwroot/domql.js answers another version than $(Version); run ./publish.ps1, which bundles DOMQL of this version and packs it." />
    </Target>

</Project>
